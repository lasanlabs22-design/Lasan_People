# Railway → your Postgres service → Variables → DATABASE_PUBLIC_URL (local dev)
# When the API itself runs on Railway, reference ${{Postgres.DATABASE_URL}} (private network, no egress fees).
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway
# Optional: force TLS on/off. Auto-detected when omitted.
# DATABASE_SSL=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL=7d

PORT=4000
# Comma-separated origins allowed to call the API from a browser (the web app calls it server-side, so this is for future clients).
CORS_ORIGINS=http://localhost:3000
# Used to decide what "today" is for attendance.
APP_TIMEZONE=Asia/Kolkata

# Used only by `npm run db:seed` to create the first admin.
ADMIN_EMAIL=admin@lasan.local
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=Administrator
ADMIN_CODE=ADMIN
